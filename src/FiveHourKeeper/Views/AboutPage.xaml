<UserControl x:Class="FiveHourKeeper.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel>
                <!-- 标题区 -->
                <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="500"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" FontSize="12"
                           Foreground="{StaticResource SubtleBrush}" Margin="0,4,0,0"/>

                <!-- 简介卡片 -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                        Padding="20" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="简介" FontWeight="500" FontSize="14"
                                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- 联系卡片 -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                        Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="加入我们" FontWeight="500" FontSize="14"
                                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QQ 群"
                                       Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding QqGroup}"
                                       Foreground="{StaticResource InkBrush}"
                                       FontFamily="Consolas, Segoe UI" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Telegram"
                                       Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="{Binding TgChannelUrl}"
                                           RequestNavigate="OnTelegramClick"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    <Run Text="{Binding TgChannelUrl}"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="YouTube"
                                       Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Top"
                                       Margin="0,2,0,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding YoutubeHint}"
                                       Foreground="{StaticResource InkBrush}"
                                       TextWrapping="Wrap" LineHeight="22"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="© FiveHourKeeper · 让每一份订阅都物尽其用"
                           Foreground="{StaticResource SubtleBrush}" FontSize="11"
                           Margin="0,24,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

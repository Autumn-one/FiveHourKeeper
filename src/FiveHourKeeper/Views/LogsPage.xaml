<UserControl x:Class="FiveHourKeeper.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="运行日志" Style="{StaticResource TitleStyle}" />
            <TextBlock Style="{StaticResource HintStyle}" Text="最近 500 条记录；API Key 永不落盘。" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Entries}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Width="150"
                                        Binding="{Binding At, Converter={StaticResource LocalTime}, ConverterParameter=MM-dd HH:mm:ss}" />
                    <DataGridTextColumn Header="模型" Binding="{Binding ModelName}" Width="*" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Kind, Converter={StaticResource EnumDisplay}}" Width="60" />
                    <DataGridTemplateColumn Header="状态" Width="76">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeStyle}" Width="60" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumDisplay}}"
                                               FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{Binding Status, Converter={StaticResource StatusTone}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="HTTP" Binding="{Binding HttpStatus}" Width="56" />
                    <DataGridTextColumn Header="耗时(ms)" Binding="{Binding LatencyMs}" Width="70" />
                    <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
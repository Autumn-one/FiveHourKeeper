<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 包缓存放在仓库内，避免受限环境下写入用户级全局缓存被拒 -->
    <add key="globalPackagesFolder" value=".nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
